{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "_comment": "SHARED FUTURES BASE. Never run this directly and never put a strategy, timeframe or pair list here. Every strategy has its own config in configs/strategies/ which pulls this in via add_config_files.",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "stake_currency": "USDT",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "tradable_balance_ratio": 0.95,
    "fee": 0.0005,
    "exchange": {
        "name": "binanceusdm",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "internals": {
        "process_throttle_secs": 5
    },
    "dataformat_ohlcv": "feather",
    "initial_state": "running",
    "hyperopt_loss": "SharpeHyperOptLossDaily",
    "hyperopt_min_trades": 50,
    "hyperopt_random_state": 42,
    "hyperopt_jobs": -1,
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "change_me_change_me_change_me_change_me",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "change_me"
    }
}
