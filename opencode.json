{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "_comment": "Tool-level guardrails for the agentic strategy framework. Enforces the RED list from AGENTS.md mechanically. Last matching rule wins: broad rules first, narrow rules last.",
  "permission": {
    "read": {
      "*": "allow",
      "config.json": "deny",
      "*/config.json": "deny",
      "user_data/config.json": "deny"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      ".agent/COMMANDS.md": "ask",
      ".agent/CONVENTIONS.md": "ask",
      ".agent/ENVIRONMENT.md": "ask",
      ".agent/phases/**": "ask",
      ".agent/prompts/**": "ask",
      ".agent/reference/**": "ask",
      ".agent/scripts/**": "ask",
      "opencode.json": "deny",
      "*/opencode.json": "deny",
      ".opencode/opencode.json": "deny",
      "config.json": "deny",
      "*/config.json": "deny",
      "user_data/config.json": "deny",
      "freqtrade/**": "deny",
      "*/freqtrade/freqtrade/**": "deny",
      "tests/**": "deny",
      "*/tests/**": "deny",
      "ft_client/**": "deny",
      "*/ft_client/**": "deny",
      "docs/**": "deny",
      "*/docs/**": "deny",
      "setup.py": "deny",
      "*/setup.py": "deny",
      "setup.cfg": "deny",
      "*/setup.cfg": "deny",
      "pyproject.toml": "deny",
      "*/pyproject.toml": "deny"
    },
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git branch -D*": "deny",
      "freqtrade trade*": "ask",
      "freqtrade trade --config configs/strategies/*.dryrun.json*": "allow",
      "rm *": "ask",
      "rm *user_data/data*": "deny",
      "*dry-run false*": "deny",
      "*config.json*": "deny"
    },
    "external_directory": {
      "/tmp/opencode/**": "allow"
    }
  }
}
